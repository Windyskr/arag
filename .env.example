# ARAG Environment Configuration
# Copy this file to .env and fill in your values

# Required: generation-agent API settings
ARAG_API_KEY=your-api-key-here
ARAG_BASE_URL=https://api.openai.com/v1
ARAG_MODEL=gpt-4o-mini

# Optional: evaluator judge settings. The evaluator resolves CLI flags first,
# then these variables, then its documented defaults. ARAG_API_KEY is reused.
# ARAG_JUDGE_MODEL=gpt-5.4-mini
# ARAG_JUDGE_BASE_URL=https://api.openai.com/v1

# Optional: HTTP proxy (if needed)
# HTTP_PROXY=http://proxy:port
# HTTPS_PROXY=http://proxy:port

# Optional: CUDA device selection
# CUDA_VISIBLE_DEVICES=0
